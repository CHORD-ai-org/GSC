# GSC local environment
# PGlite is the default local adapter because no Docker daemon is available here.
PORT=8788
DB_ADAPTER=pglite
PGLITE_DIR=./.data/pglite
STORAGE_DIR=./data/files

# PostgreSQL adapter, kept for future Docker/managed deployment.
# DB_ADAPTER=postgres
# DATABASE_URL=postgres://gsc:dev@127.0.0.1:55433/gsc

# LLM provider (D-052, OpenAI-compatible). Default: Xiaomi MiMo.
# Fill GSC_LLM_API_KEY in .env.local, then verify with: npm run llm:check
# GSC_LLM_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1   (Token Plan tp- key) / https://api.xiaomimimo.com/v1 (pay-as-you-go sk- key)
# GSC_LLM_API_KEY=
# GSC_LLM_MODEL=mimo-v2.6-flash   # alternatives: mimo-v2.6-pro / mimo-v2.6-pro-ultraspeed

# Hardening (M1, D-068…D-070)
# GSC_CORS_ORIGINS=https://app.example,https://admin.example
# GSC_INGEST_ALLOW_PRIVATE=1        # dev/test only — NEVER in production
# GSC_SECRETS_KEY=<64-hex or passphrase>
