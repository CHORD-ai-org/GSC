{
  "name": "gsc",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "GSC — Global Shared Context. Independent MVP prototype.",
  "scripts": {
    "dev": "vite",
    "api": "node --env-file-if-exists=.env.local server/index.ts",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "node --env-file-if-exists=.env.local server/persistence/migrate.ts",
    "db:reset": "node --env-file-if-exists=.env.local server/persistence/reset.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "drizzle-kit": "^0.31.11",
    "typescript": "~5.7.2",
    "vite": "^6.0.7",
    "vitest": "^5.1.0"
  }
}
