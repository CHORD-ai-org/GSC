{
  "name": "gsc",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "GSC — Global Shared Context. Independent MVP prototype.",
  "scripts": {
    "dev": "vite",
    "api": "node --env-file-if-exists=.env.local server/index.ts",
    "worker": "node --env-file-if-exists=.env.local server/worker.ts",
    "mcp": "node --env-file-if-exists=.env.local server/mcp/index.ts",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "db:migrate": "node --env-file-if-exists=.env.local server/persistence/migrate.ts",
    "db:reset": "node --env-file-if-exists=.env.local server/persistence/reset.ts",
    "api:check": "node scripts/api-checks.mjs",
    "llm:check": "node --env-file-if-exists=.env.local scripts/llm-check.mjs",
    "db:backup": "node scripts/db-backup.mjs",
    "db:restore": "node scripts/db-restore.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.73.0",
    "vite": "^6.0.7",
    "vitest": "^5.1.0"
  }
}
